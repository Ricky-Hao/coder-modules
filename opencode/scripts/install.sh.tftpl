#!/usr/bin/env bash
set -euo pipefail
umask 077
for prerequisite in bash python3 curl tar xz; do
  command -v "$prerequisite" >/dev/null || { echo "OpenCode: missing $prerequisite" >&2; exit 1; }
done
exec python3 -B - <<'OPENCODE_BOOTSTRAP'
import base64, json, sys
if sys.version_info < (3, 11):
    sys.exit("OpenCode requires Python 3.11+")
BUNDLE = json.loads(base64.b64decode('${bundle}'))
exec(compile(BUNDLE['files']['install.py'], '<opencode-installer>', 'exec'))
OPENCODE_BOOTSTRAP
