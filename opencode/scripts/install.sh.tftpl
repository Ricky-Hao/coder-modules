#!/usr/bin/env bash
set -euo pipefail
umask 077
for prerequisite in bash python3 curl tar xz; do
  command -v "$prerequisite" >/dev/null || { echo "OpenCode: missing $prerequisite" >&2; exit 1; }
done
exec python3 -B - <<'OPENCODE_BOOTSTRAP'
import base64, hashlib, json, lzma, sys
if sys.version_info < (3, 11):
    sys.exit("OpenCode requires Python 3.11+")
source = lzma.decompress(base64.b64decode('${bundle}'))
if hashlib.sha256(source).hexdigest() != '${sha256}':
    sys.exit('OpenCode source bundle checksum mismatch')
parts = source.decode().split('\0')
BUNDLE = {'config': json.loads(base64.b64decode('${config}')), 'files': dict(zip(parts[::2], parts[1::2], strict=True))}
exec(compile(BUNDLE['files']['install.py'], '<opencode-installer>', 'exec'))
OPENCODE_BOOTSTRAP
